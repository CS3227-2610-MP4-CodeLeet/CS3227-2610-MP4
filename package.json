{
  "name": "cs3227-mp4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node workflow/scripts/dev.mjs",
    "build": "node workflow/scripts/build-static-runtime.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "ai:model-eval": "node workflow/scripts/evaluate-soclaas-models.mjs",
    "ai:context-eval": "node workflow/scripts/evaluate-context-strategies.mjs",
    "ai:dev-context-eval": "node workflow/scripts/evaluate-development-context.mjs",
    "ai:promptfoo": "node workflow/scripts/run-promptfoo-evaluation.mjs offline",
    "ai:promptfoo:live": "node workflow/scripts/run-promptfoo-evaluation.mjs live",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "node workflow/scripts/warn-local-db-reset.mjs && supabase db reset --local --no-seed && supabase db query --local --file supabase/seed.sql",
    "db:seed": "node workflow/scripts/warn-local-db-reset.mjs && supabase db reset --local --no-seed && supabase db query --local --file supabase/seed.sql",
    "db:test": "supabase test db",
    "db:status": "supabase status",
    "site:dev": "pnpm --filter @cs3227/mp4-website run start",
    "site:build": "pnpm --filter @cs3227/mp4-website run build",
    "site:serve": "pnpm --filter @cs3227/mp4-website run serve",
    "check:scaffold": "node workflow/scripts/check-scaffold.mjs",
    "spec:validate": "openspec validate --all --strict"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "prism-react-renderer": "2.4.1",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "promptfoo": "0.125.1",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
