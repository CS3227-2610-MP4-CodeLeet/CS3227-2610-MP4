{
  "name": "cs3227-mp4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node workflow/scripts/build-static-runtime.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "node workflow/scripts/warn-local-db-reset.mjs && supabase db reset --local --no-seed && supabase db query --local --file supabase/seed.sql",
    "db:seed": "node workflow/scripts/warn-local-db-reset.mjs && supabase db reset --local --no-seed && supabase db query --local --file supabase/seed.sql",
    "db:test": "supabase test db",
    "db:status": "supabase status",
    "site:dev": "pnpm --filter @cs3227/mp4-website run start",
    "site:build": "pnpm --filter @cs3227/mp4-website run build",
    "site:serve": "pnpm --filter @cs3227/mp4-website run serve",
    "check:scaffold": "node workflow/scripts/check-scaffold.mjs",
    "spec:validate": "openspec validate --all --strict"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "prism-react-renderer": "2.4.1",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.8.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
