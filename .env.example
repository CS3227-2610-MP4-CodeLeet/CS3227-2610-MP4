# Future configuration contract. No application currently reads these variables.
# Use separate values/projects for development and production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_SITE_URL=http://localhost:3000

# Server only. Never prefix secrets with NEXT_PUBLIC_.
SOCLAAS_AI_ENABLED=false
SOCLAAS_BASE_URL=
SOCLAAS_API_KEY=
SOCLAAS_MODEL=

# Set from verified key-specific provider limits before enabling AI.
SOCLAAS_REQUESTS_PER_MINUTE=
# Add a privileged Supabase key only if a reviewed metadata operation needs one.
# Browser runtime configuration will follow the runtime feasibility decision.
