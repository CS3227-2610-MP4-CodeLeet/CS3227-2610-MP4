# Development-only sample assignment preview. Production ignores this flag.
STUDENT_PREVIEW_ENABLED=false
STUDENT_RUNNER_PREVIEW_ENABLED=false

# Local Supabase values; obtain the generated URL and publishable key from `pnpm db:status`.
# Keep separate Supabase projects and credentials for development and production.
# Browser-safe Supabase values. The server uses the publishable key with the user's session and RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_SITE_URL=http://localhost:3000

# Server only. Never prefix secrets with NEXT_PUBLIC_.
SOCLAAS_AI_ENABLED=false
# Obtain the API key/model through the authorized SoCLaaS portal. AI remains disabled by default.
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg
SOCLAAS_API_KEY=
SOCLAAS_MODEL=
# Add a privileged Supabase key only if a reviewed metadata operation needs one.
# Browser runtime configuration will follow the runtime feasibility decision.
