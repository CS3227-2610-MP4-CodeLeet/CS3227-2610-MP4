# Local development uses real accounts and assignments.
# Browser Run code is enabled automatically in development; start port 3130.
# Synthetic assignment fixtures are selected only by the Playwright test harness.
# Optional standalone examples in real assignments; development only.
# Never instructor-authored cases; production ignores this flag.
STUDENT_TEST_CASE_FIXTURES_ENABLED=false

# Local Supabase values; obtain the generated URL and publishable key from `pnpm db:status`.
# Keep separate Supabase projects and credentials for development and production.
# Browser-safe Supabase values. The server uses the publishable key with the user's session and RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_SITE_URL=http://localhost:3000

# Server only. Never prefix secrets with NEXT_PUBLIC_.
SOCLAAS_AI_ENABLED=false
# Obtain the API key/model through the authorized SoCLaaS portal. AI remains disabled by default.
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg
SOCLAAS_API_KEY=
# Recommended by the synthetic comparison in workflow/experiments/2026-11-01-soclaas-model-evaluation.md.
SOCLAAS_MODEL=qwen3-coder-next
# Server only: reviewed username lookup and atomic login attempt reservations.
# Configure separately for development/production; never use NEXT_PUBLIC_ names.
SUPABASE_SECRET_KEY=
# Random server-only secret, at least 32 characters, for login identifier HMACs.
AUTH_RATE_LIMIT_SECRET=
# Browser runtime configuration will follow the runtime feasibility decision.
